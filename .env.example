# Copy to .env.local. Both values are optional for a local demo (safe defaults are built in).
SESSION_SECRET=change-me-to-a-long-random-string
# Enables the demo helpers: the sign-in dialog's demo accounts, "Reset demo data" and the Unverified variant.
DEMO_MODE=true
# Optional: where the SQLite file lives (default data/crats.db).
# DATABASE_PATH=data/crats.db
